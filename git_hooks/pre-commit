#!/bin/bash

source "$(dirname "$0")/_config.sh"

FAIL=0

# Function to check if a linter exists and run it
run_linter() {
    local linter="$1"
    local cmd="$2"
    local extensions=(${!3})
    local flags="$4"
    local install_msg="$5"
    shift 5
    local check_dirs=("${@}")

    if [[ ! -x "$cmd" ]]; then
        echo -e "${RED}[ERROR]${NC} $linter not found. $install_msg"
        FAIL=1
        return
    fi

     ALL_FILES=($(git diff --cached --name-only --diff-filter=ACM | grep -E "\.($(IFS='|'; echo "${extensions[*]}")$)"))

     FILES=()
     for file in "${ALL_FILES[@]}"; do
         for dir in "${check_dirs[@]}"; do
             if [[ "$file" == "$dir"* ]]; then
                 FILES+=("$file")
                 break
             fi
         done
     done

    if [[ ${#FILES[@]} -eq 0 ]]; then
        echo -e "${YELLOW}[SKIP]${NC} No files to lint with $linter."
        return
    fi

    echo -e "${BLUE}[INFO]${NC} Running $linter on staged files..."
    echo -e "${BLUE}[INFO]${NC} To check files: ${FILES[@]}"
    $cmd $flags "${FILES[@]}"
    if [[ $? -ne 0 ]]; then
        echo -e "${RED}[FAIL]${NC} $linter found issues."
        FAIL=1
    else
        echo -e "${GREEN}[PASS]${NC} $linter passed."
    fi
}

# Run linters
run_linter "ESLint" "$ESLINT" ESLINT_EXTENSIONS[@] "$ESLINT_FLAGS" "$ESLINT_INSTALL_MSG" "${ESLINT_CHECK_DIRS[@]}"
run_linter "PHP_CodeSniffer" "$PHPCS" PHPCS_EXTENSIONS[@] "$PHPCS_FLAGS" "$PHPCS_INSTALL_MSG" "${PHPCS_CHECK_DIRS[@]}"

exit $FAIL
